    {
      "parameters": {
        "jsCode": "const items = $input.all().map(item => item.json);\nconst batches = [];\n\nfor (let i = 0; i < items.length; i += 10) {\n  batches.push({\n    json: {\n      events: items.slice(i, i + 10)\n    }\n  });\n}\n\nreturn batches;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
