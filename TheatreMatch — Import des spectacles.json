  "name": "TheatreMatch — Import des spectacles",
  "nodes": [
    {
      "parameters": {
        "url": "https://opendata.paris.fr/api/explore/v2.1/catalog/datasets/que-faire-a-paris-/records",
        "sendQuery": true,
        "queryParameters": {
