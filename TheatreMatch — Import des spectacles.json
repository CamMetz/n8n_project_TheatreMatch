            },
            {
              "name": "select",
              "value": "id,title_event,date_start,date_end,occurrences,date_description,qfap_tags,price_type,price_detail,audience,locations,access_link,description"
            },
            {
              "name": "where",
              "value": "qfap_tags like \"%Théâtre%\""
            }
          ]
        },
        "options": {
          "pagination": {
