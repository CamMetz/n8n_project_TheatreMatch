      ],
      "id": "b0437912-20fb-477b-85c0-7b536438b741",
      "name": "Regrouper par 10"
    },
    {
      "parameters": {
        "jsCode": "const batches = $('Regrouper par 10').all()\n  .map(item => item.json.events || []);\n\nconst outputs = $input.all().map(item =>\n  item.json.output?.results ?? item.json.results ?? []\n);\n\nreturn batches.flatMap((events, batchIndex) => {\n  const results = outputs[batchIndex] || [];\n\n  return events.map((event, index) => {\n    const result = results.find(\n      r => Number(r.index) === index\n    );\n\n    return {\n      json: {\n        ...event,\n        genre: result?.genre || event.genre || 'Indéterminé',\n        genreJustification: result?.justification || ''\n      }\n    };\n  });\n});"
      },
