      ],
      "id": "d0a850bf-c77a-413f-9bfe-d0805a4fa202",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "\nconst response = $input.first().json;\nconst events = response.results ?? [];\n\nreturn events\n  .filter(event =>\n    (event.qfap_tags ?? \"\")\n      .toLowerCase()\n      .includes(\"théâtre\")\n  )\n  .map(event => {\n    const location = event.locations?.[0] ?? {};\n    const descriptionText = (event.description || \"\")\n      .replace(/<[^>]*>/g, \" \")\n      .replace(/&nbsp;/g, \" \")\n      .trim();\n    const title =\n      event.title_event ||\n      descriptionText.match(/^(.*?)\\s+est une énigme/i)?.[1] ||\n      null;\n    const occurrences = event.occurrences ?? null;\n    const bookingLink = event.access_link ?? null;\n    const hasExactSessions = Boolean(occurrences);\n    const hasTitleAndSessions = Boolean(title && occurrences);\n\n    return {\n      json: {\n        sourceEventId: event.id ?? null,\n        title,\n        titleMissing: !title,\n        description: event.description ?? null,\n        dateStart: event.date_start ?? null,\n        dateEnd: event.date_end ?? null,\n        occurrences,\n        dateDescription: event.date_description ?? null,\n        category: event.qfap_tags ?? \"\",\n        priceType: event.price_type ?? \"Non renseigné\",\n        priceDetail: event.price_detail ?? null,\n        audience: event.audience ?? \"Non renseigné\",\n        venue: location.address_name ?? \"Lieu non renseigné\",\n        address: location.address_street ?? \"\",\n        postcode: location.address_zipCode ?? \"\",\n        bookingLink,\n        hasUsefulDates: Boolean(occurrences || event.date_description),\n        hasBookingLink: Boolean(bookingLink),\n        hasExactSessions,\n        hasTitleAndSessions\n      }\n    };\n  });\n"
      },
