      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "Welcome to TheatreMatch!  \nI help you find theatre shows in Paris based on your preferences.  \nHere's how to get started: \n• /preferences — save or update your usual preferences \n• /recherche — start a one-time search \n• Send me a message describing what you're looking for, without changing your saved preferences.  \nExample: “I'm looking for a comedy under €20 in the 8th arrondissement on Saturday evening.”",
        "additionalFields": {}
      },
